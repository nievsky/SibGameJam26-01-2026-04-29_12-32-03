  - m_Id: 19134147174400
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 20015441747968
    m_Localized: "\u041A\u0430\u043A \u0438\u0433\u0440\u0430\u0442\u044C\n\n\u0426\u0435\u043B\u044C:
      \u0421\u0440\u0443\u0431\u0438\u0442\u044C \u041A\u043E\u0440\u043E\u043B\u044F.\n\u0410\u0440\u0441\u0435\u043D\u0430\u043B:
      \u0421\u0440\u0443\u0431\u0430\u044F \u0444\u0438\u0433\u0443\u0440\u044B (\u043A\u0440\u043E\u043C\u0435
      \u041A\u043E\u0440\u043E\u043B\u044F \u0438 \u0424\u0435\u0440\u0437\u044F),
      \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u0431\u0440\u0430\u0442\u044C \u0435\u0451
      \u0441\u0435\u0431\u0435\n\u041C\u0435\u0442\u0430\u043C\u043E\u0440\u0444\u043E\u0437\u0430:
      \u0422\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u0442\u044C\u0441\u044F
      \u0432 \u043B\u044E\u0431\u0443\u044E \u0444\u0438\u0433\u0443\u0440\u0443
      \u0438\u0437 \u0430\u0440\u0441\u0435\u043D\u0430\u043B\u0430 \u0432 \u043B\u044E\u0431\u043E\u0439
      \u043C\u043E\u043C\u0435\u043D\u0442.\n\u041F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u0435:
      \u0415\u0441\u043B\u0438 \u0442\u0432\u043E\u044E \u0444\u0438\u0433\u0443\u0440\u0443
      \u0441\u0440\u0443\u0431\u0438\u043B\u0438 - \u0443\u0440\u043E\u0432\u0435\u043D\u044C
      \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F \u0437\u0430\u043D\u043E\u0432\u043E.\n\n\u0414\u0432\u0438\u0436\u0435\u043D\u0438\u0435
      \u0444\u0438\u0433\u0443\u0440\n\u041F\u0435\u0448\u043A\u0430: \u0425\u043E\u0434
      \u043D\u0430 1 \u043A\u043B\u0435\u0442\u043A\u0443 \u0432\u043F\u0435\u0440\u0435\u0434,
      \u0440\u0443\u0431\u043A\u0430 - \u043D\u0430 1 \u043A\u043B\u0435\u0442\u043A\u0443
      \u043F\u043E \u0434\u0438\u0430\u0433\u043E\u043D\u0430\u043B\u0438.\n\u041B\u0430\u0434\u044C\u044F:
      \u041F\u043E \u043F\u0440\u044F\u043C\u043E\u0439 \u0434\u043E \u043A\u0440\u0430\u044F
      \u0434\u043E\u0441\u043A\u0438 \u0438\u043B\u0438 \u0434\u043E \u043F\u0435\u0440\u0432\u043E\u0439
      \u0446\u0435\u043B\u0438.\n\u0421\u043B\u043E\u043D: \u041F\u043E \u0434\u0438\u0430\u0433\u043E\u043D\u0430\u043B\u0438
      \u0434\u043E \u043A\u0440\u0430\u044F \u0434\u043E\u0441\u043A\u0438 \u0438\u043B\u0438
      \u0434\u043E \u043F\u0435\u0440\u0432\u043E\u0439 \u0446\u0435\u043B\u0438.\n\u041A\u043E\u043D\u044C:
      \u0411\u0443\u043A\u0432\u043E\u0439 \"\u0413\" \u0432 \u043B\u044E\u0431\u0443\u044E
      \u0441\u0442\u043E\u0440\u043E\u043D\u0443.\n\n\u0417\u0432\u0451\u0437\u0434\u044B
      \u0437\u0430 \u0443\u0440\u043E\u0432\u0435\u043D\u044C:\n\u041F\u0435\u0440\u0432\u0430\u044F
      \u0437\u0432\u0435\u0437\u0434\u0430: \u0437\u0430 \u043F\u043E\u0431\u0435\u0434\u0443
      (\u0441\u0440\u0443\u0431\u0438\u0442\u044C \u041A\u043E\u0440\u043E\u043B\u044F).\n\u0412\u0442\u043E\u0440\u0430\u044F
      \u0437\u0432\u0435\u0437\u0434\u0430: \u0437\u0430 \u043F\u0440\u043E\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435
      \u0431\u0435\u0437 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043E\u043A.\n\u0422\u0440\u0435\u0442\u044C\u044F
      \u0437\u0432\u0435\u0437\u0434\u0430: \u0437\u0430 \u043D\u0443\u0436\u043D\u043E\u0435
      \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u043E\u0447\u043A\u043E\u0432
      (\u0440\u0443\u0431\u043A\u0430 \u0432\u0440\u0430\u0433\u043E\u0432)."
    m_Metadata:
      m_Items: []
  - m_Id: 20160120070144
    m_Localized: "\u041F\u043E\u0434\u0441\u0432\u0435\u0442\u0438\u0442\u044C \u043F\u043E\u043B\u044F
      \u043F\u043E\u0434 \u0430\u0442\u0430\u043A\u043E\u0439 \u043D\u0430 \"H\"
